# Copiar a .env y ajustar. Los valores por defecto coinciden con el docker-compose local.
NODE_ENV=development
PORT=3000

# La URI debe incluir replicaSet=rs0: las transacciones multi-documento (doc 04 §6)
# no funcionan contra un mongod standalone.
MONGODB_URI=mongodb://localhost:27017/eventix?replicaSet=rs0
MONGODB_DB=eventix

LOG_LEVEL=info
